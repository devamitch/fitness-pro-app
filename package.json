    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-react-native": "^1.0.0",
    "apisauce": "3.0.1",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.1.0",
    "expo": "^52.0.46",
    "expo-apple-authentication": "7.1.3",
